# Read by the BigWigs packager (.github/workflows/release.yml).
# The addon lives in the RudeBoy/ subfolder, so that folder becomes the zip's top level
# and everything else in the repo (tests, docs, workflows) is left out.
package-as: RudeBoy

move-folders:
  RudeBoy/RudeBoy: RudeBoy

# CHANGELOG.md must not be ignored: the packager reads it from the build for the upload notes
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tests
  - README.md
  - RELEASING.md
